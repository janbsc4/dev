#!/usr/bin/env bash
# ompidmund — open the last assistant response of the current project's
# most recent omp session in Edmund (Markdown editor).
set -euo pipefail

SESSIONS_DIR="$HOME/.omp/agent/sessions"
TERMINAL_SESSIONS_DIR="$HOME/.omp/agent/terminal-sessions"
cwd=$(pwd -P)
tmp="${TMPDIR:-/tmp}"
tmp="${tmp%/}"

# omp stores sessions per working directory. Unlike pi, it names the
# folder home-relative: /Users/jan/dev -> -dev, $HOME itself -> -,
# $TMPDIR subdirectories -> -tmp-<relative path>, and anything outside
# both falls back to the absolute scheme --<path with / replaced by ->--.
case "$cwd" in
  "$HOME")
    key="-" ;;
  "$HOME"/*)
    rel="${cwd#"$HOME"}"
    rel="${rel#/}"
    key="-${rel//\//-}" ;;
  "$tmp"/*)
    rel="${cwd#"$tmp"}"
    rel="${rel#/}"
    key="-tmp-${rel//\//-}" ;;
  *)
    key="--${cwd#/}"
    key="${key//\//-}--" ;;
esac

# omp exports no session-file variable (its env reference documents none), so
# prefer the per-terminal pointer it keeps under terminal-sessions/<tty>. That
# file holds the cwd, then the session file, then an optional status, and it
# survives across sessions, so it identifies the session this terminal last
# ran. This is an internal detail, not a documented contract: every step below
# is validated, and anything unexpected falls back to the newest session file
# for the working directory.
resolve_session_file() {
  local tty_name="" pointer candidate

  if [ -n "${TTY:-}" ]; then
    tty_name=$(basename "$TTY")
  elif tty_name=$(tty 2>/dev/null); then
    tty_name=$(basename "$tty_name")
  else
    tty_name=""
  fi

  if [ -n "$tty_name" ]; then
    pointer="$TERMINAL_SESSIONS_DIR/$tty_name"
    if [ -f "$pointer" ]; then
      candidate=$(sed -n '2p' "$pointer")
      case "$candidate" in
        *.jsonl)
          if [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
          fi
          ;;
      esac
    fi
  fi

  # Fallback: newest session file for this working directory.
  local dir="$SESSIONS_DIR/$key"
  [ -d "$dir" ] || { echo "No omp sessions found for $(pwd)" >&2; return 1; }

  local file
  file=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -n 1)
  [ -n "$file" ] || { echo "No session files in $dir" >&2; return 1; }
  printf '%s\n' "$file"
}

file=$(resolve_session_file)

# Last assistant message: join all text blocks (skip thinking/tool calls)
text=$(jq -rs '
  map(select(.type == "message" and .message.role == "assistant"))
  | last
  | .message.content
  | map(select(.type == "text") | .text)
  | join("\n\n")
' "$file")

[ -n "$text" ] || { echo "No assistant response found in $file" >&2; exit 1; }

# macOS mktemp rejects templates with characters after the X's,
# so create the file first and rename it afterwards.
out=$(mktemp "${TMPDIR:-/tmp}/omp-response-XXXXXX")
mv "$out" "$out.md" && out="$out.md"
printf '%s\n' "$text" > "$out"

open -a Edmund "$out"

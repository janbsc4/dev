#!/usr/bin/env bash
# pidmund — open the last assistant response of the current project's
# most recent pi session in Edmund (Markdown editor).
set -euo pipefail

SESSIONS_DIR="$HOME/.pi/agent/sessions"

# Inside a pi session PI_SESSION_FILE names the exact transcript. Preferring it
# avoids picking up a collaborating subagent's transcript, because process-mode
# subagents write into the same cwd-scoped directory as their coordinator.
resolve_session_file() {
  if [ -n "${PI_SESSION_FILE:-}" ] && [ -f "$PI_SESSION_FILE" ]; then
    printf '%s\n' "$PI_SESSION_FILE"
    return 0
  fi

  # Outside pi: newest session file for this working directory.
  # Sessions are stored per working directory, / replaced by -,
  # e.g. /Users/jan/cv -> --Users-jan-cv--
  local cwd key dir
  cwd=$(pwd -P)
  key="--${cwd#/}"
  key="${key//\//-}--"
  dir="$SESSIONS_DIR/$key"
  [ -d "$dir" ] || { echo "No pi sessions found for $(pwd)" >&2; return 1; }

  local file
  file=$(ls -t "$dir"/*.jsonl 2>/dev/null | head -n 1)
  [ -n "$file" ] || { echo "No session files in $dir" >&2; return 1; }
  printf '%s\n' "$file"
}

file=$(resolve_session_file)

# Last assistant message: join all text blocks (skip thinking/tool calls)
text=$(jq -rs '
  map(select(.type == "message" and .message.role == "assistant"))
  | last
  | .message.content
  | map(select(.type == "text") | .text)
  | join("\n\n")
' "$file")

[ -n "$text" ] || { echo "No assistant response found in $file" >&2; exit 1; }

# macOS mktemp rejects templates with characters after the X's,
# so create the file first and rename it afterwards.
out=$(mktemp "${TMPDIR:-/tmp}/pi-response-XXXXXX")
mv "$out" "$out.md" && out="$out.md"
printf '%s\n' "$text" > "$out"

open -a Edmund "$out"
